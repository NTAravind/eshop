{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/*": ["./shared/components/ui/*"],
      "@/components/modals/*": ["./shared/components/modals/*"],
      "@/components/providers": ["./shared/components/providers"],
      "@/components/builder": ["./modules/builder/components/index"],
      "@/components/builder/*": ["./modules/builder/components/*"],
      "@/components/admin/*": ["./modules/admin/components/*"],
      "@/components/superadmin/*": ["./modules/superadmin/components/*"],
      "@/components/auth/*": ["./modules/auth/components/*"],
      "@/components/*": ["./shared/components/*"],
      "@/modules/*": ["./modules/*"],
      "@/server/*": ["./server/*"],
      "@/shared/*": ["./shared/*"],
      "@/hooks/*": ["./shared/hooks/*"],
      "@/types/*": ["./shared/types/*"],
      "@/middleware/*": ["./server/middleware/*"],
      "@/dal/*": ["./server/dal/*"],
      "@/services/*": ["./server/services/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
